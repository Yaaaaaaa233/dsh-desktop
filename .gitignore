# 依赖与构建产物
node_modules/
dist/
dist-app/
build/

# DSH 后端运行时（build:runtime 的产物，含 node_modules，体积大且可再生成）
runtime/
resources/node/
resources/dsh-runtime.tar.gz

# web profile 备份（含配置，可能带 API key，不入库）
web-profile-backup-*/

# 日志 / 系统
*.log
.DS_Store
.selftest/
.npm-cache/
.electron-cache/
.electron-builder-cache/

# 密钥与本地配置（绝不入库）
.env
.env.*
*.pem
*.p12
*.key
*.token
*.local

# 多内核并存的运行时构建产物（runtime-016 等）
runtime*/

# 官方 Desktop 适配项目的本地数据与发布产物
/dist/
/backups/
/.test-home/
/.cache/
**/.dsh/
**/.dshw-*.json
**/credentials.json
**/settings.yaml
**/settings.yaml.imported
**/skin-center-active.json
*.tgz
